<Project>

  <PropertyGroup>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Application">
	<!-- MediatR pinned to v12.x (Apache-2.0); v13+ needs a commercial licence (spec §8). -->
	<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
	<PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
	<PackageVersion Include="MediatR" Version="12.5.0" />
	<PackageVersion Include="FluentValidation" Version="12.2.0" />
	<PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
	<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
	<PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
	<PackageVersion Include="Hangfire.Core" Version="1.8.25" />
	<PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
	<PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
	<PackageVersion Include="QRCoder" Version="1.8.1" />
	<PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="Web">
	<PackageVersion Include="MudBlazor" Version="9.12.0" />
	<PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
	<PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
	<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Transitive security pins">
  <!-- Pinned to clear NU1902/NU1903 advisories on transitive dependencies. -->
  <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup Label="Tests">
	<PackageVersion Include="xunit" Version="2.9.3" />
	<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
	<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
	<PackageVersion Include="Shouldly" Version="4.3.0" />
	<PackageVersion Include="NSubstitute" Version="6.2.0" />
	<PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
	<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
	<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
	<!-- VERIFY: spec names UglyToad.PdfPig, which has no stable release on nuget.org; the library now ships as PdfPig. -->
	<PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
