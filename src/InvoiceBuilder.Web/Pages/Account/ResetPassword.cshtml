@page "/account/reset-password"
@model InvoiceBuilder.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}
<h1>Choose a new password</h1>
@if (Model.Error is not null)
{
    <p class="auth-error" role="alert">@Model.Error</p>
}
<form method="post">
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <label class="auth-field">New password
        <input asp-for="Password" type="password" autocomplete="new-password" required />
    </label>
    <button class="auth-button" type="submit">Reset password</button>
</form>
