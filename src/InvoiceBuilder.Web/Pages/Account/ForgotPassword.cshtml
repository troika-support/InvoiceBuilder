@page "/account/forgot-password"
@model InvoiceBuilder.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<h1>Forgot your password?</h1>
@if (Model.Sent)
{
    <p>If that email belongs to an account, we have sent a reset link.</p>
}
else
{
    <form method="post">
        <label class="auth-field">Email
            <input asp-for="Email" type="email" autocomplete="username" required />
        </label>
        <button class="auth-button" type="submit">Send reset link</button>
    </form>
}
