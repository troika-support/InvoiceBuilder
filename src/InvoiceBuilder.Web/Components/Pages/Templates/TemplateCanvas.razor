@page "/templates/{Id:guid}/design"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Owner")]
@implements IAsyncDisposable
@using System.Text.Json
@using InvoiceBuilder.Application.Templates
@inject MediatR.ISender Sender
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Template designer · Invoice Builder</PageTitle>

@if (_error is not null)
{
    <EmptyState Title="Template not available" Message="@_error" ActionText="Back to templates" ActionHref="/templates" />
}
else if (_template is not null)
{
    <div class="ib-designer">
        <header class="ib-designer__bar">
            <a href="/templates" aria-label="Back to templates">‹ Templates</a>
            <h1 class="ib-page-title" style="margin:0;font-size:1.1rem;">@_template.Name</h1>
            <span class="ib-help" role="status" aria-live="polite">A4 · @(_template.DraftVersion is { } d ? $"Editing draft v{d}" : "No draft yet")@(_template.PublishedVersion is { } p ? $" — v{p} is live" : "")@(_state.Dirty ? " · Unsaved changes" : "")</span>
            <span class="ib-designer__spacer"></span>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => CallAsync("undo"))" Disabled="@(!_state.CanUndo)" aria-label="Undo">Undo</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => CallAsync("redo"))" Disabled="@(!_state.CanRedo)" aria-label="Redo">Redo</MudButton>
            @foreach (var z in new[] { "50", "75", "100", "fit" })
            {
                var zoom = z;
                <MudButton Variant="@(_zoom == zoom ? Variant.Filled : Variant.Outlined)" OnClick="@(() => ZoomAsync(zoom))">@(zoom == "fit" ? "Fit" : zoom + "%")</MudButton>
            }
            <MudButton Variant="Variant.Outlined" OnClick="TogglePreviewAsync">@(_preview ? "Back to editing" : "Preview with sample data")</MudButton>
            <MudButton Variant="Variant.Outlined" Href="@($"/api/templates/{Id}/test-pdf")" Target="_blank" Disabled="@(_template.DraftVersion is null && !_saved)">Test PDF</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="SaveAsync" Disabled="@(_busy || !_state.Dirty)">Save draft</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PublishAsync" Disabled="CannotPublish">@(PublishLabel)</MudButton>
        </header>

        <div class="ib-designer__body">
            <aside class="ib-designer__left" aria-label="Insert and layers">
                <h2 class="ib-designer__h">Insert</h2>
                <div class="ib-designer__insert">
                    @foreach (var (key, label) in Inserts)
                    {
                        var k = key;
                        <button type="button" class="ib-designer__tile" @onclick="@(() => CallAsync("add", k))">@label</button>
                    }
                </div>
                <h2 class="ib-designer__h">Layers</h2>
                <div class="ib-designer__order" role="group" aria-label="Layer order">
                    <button type="button" class="ib-designer__order-btn" disabled="@(_state.Selected?.Kind != "el")" @onclick="@(() => CallAsync("toFront"))">Bring to front</button>
                    <button type="button" class="ib-designer__order-btn" disabled="@(_state.Selected?.Kind != "el")" @onclick="@(() => CallAsync("toBack"))">Send to back</button>
                </div>
                <ul class="ib-designer__layers">
                    @foreach (var l in _state.Layers)
                    {
                        var id = l.Id;
                        <li class="@(_state.Selected?.Id == id ? "is-selected" : null)" draggable="true"
                            @ondragstart="@(() => _dragId = id)"
                            @ondragover:preventDefault
                            @ondrop="@(() => DropLayerAsync(id))">
                            <button type="button" class="ib-designer__layer" @onclick="@(() => CallAsync("select", id))">@l.Type · @Trim(l.Label)</button>
                            <button type="button" class="ib-designer__icon" aria-label="@(l.Locked ? "Unlock" : "Lock") layer" @onclick="@(() => PatchAsync(id, new { locked = !l.Locked }))">@(l.Locked ? "🔒" : "🔓")</button>
                            <button type="button" class="ib-designer__icon" aria-label="@(l.Hidden ? "Show" : "Hide") layer" @onclick="@(() => PatchAsync(id, new { hidden = !l.Hidden }))">@(l.Hidden ? "Show" : "Hide")</button>
                                </li>
                            }
                </ul>
            </aside>

            <section class="ib-designer__centre" aria-label="Canvas">
                <div role="tablist" class="ib-designer__tabs">
                    <button type="button" role="tab" aria-selected="@(_state.Layer == "first")" @onclick="@(() => LayerAsync("first"))">First page</button>
                    <button type="button" role="tab" aria-selected="@(_state.Layer == "continuation")" @onclick="@(() => LayerAsync("continuation"))">Continuation pages</button>
                </div>
                <div id="ib-designer-host" class="ib-designer__host" hidden="@_preview">
                    <div class="ib-designer__page"><canvas id="ib-designer-canvas"></canvas></div>
                </div>
                @if (_preview)
                {
                    <iframe class="ib-designer__preview" title="Template preview with sample data" sandbox srcdoc="@_previewHtml"></iframe>
                }
            </section>

            <aside class="ib-designer__right" aria-label="Properties">
                <h2 class="ib-designer__h">Properties</h2>
                @if (_state.Selected is { } s)
                {
                    <div class="ib-designer__grid">
                        <MudNumericField T="double" Label="X (mm)" Value="s.XMm" ValueChanged="@(v => GeoAsync(new { xMm = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudNumericField T="double" Label="Y (mm)" Value="s.YMm" ValueChanged="@(v => GeoAsync(new { yMm = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudNumericField T="double" Label="@WidthLabel(s)" Value="s.WidthMm" ValueChanged="@(v => GeoAsync(new { widthMm = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        @if (s.Kind == "el" && s.Type != "line")
                        {
                            <MudNumericField T="double" Label="Rotation (°)" Value="s.Rotation" ValueChanged="@(v => PatchAsync(s.Id!, new { rotation = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField T="double" Label="Opacity (0-1)" Min="0.05" Max="1" Step="0.05" Value="s.Opacity" ValueChanged="@(v => PatchAsync(s.Id!, new { opacity = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        @if (s.Kind == "el" && s.Type != "line")
                        {
                            <MudNumericField T="double" Label="H (mm)" Value="s.HeightMm" ValueChanged="@(v => GeoAsync(new { heightMm = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                    </div>
                    @if (s.Kind == "el" && s.Type == "text")
                    {
                        <MudTextField T="string" Label="Text" Value="s.Text" ValueChanged="@(v => PatchAsync(s.Id!, new { text = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                    }
                    @if (s.Kind == "el" && s.Type == "shape")
                    {
                        <MudSelect T="string" Label="Shape" Value="@(s.Shape ?? "rect")" ValueChanged="@(v => PatchAsync(s.Id!, new { shape = v }))" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("rect")">Rectangle</MudSelectItem>
                            <MudSelectItem T="string" Value="@("ellipse")">Ellipse / circle</MudSelectItem>
                        </MudSelect>
                        @if (s.Shape != "ellipse")
                        {
                            <MudNumericField T="double" Label="Corner radius (mm)" Min="0" Value="s.RadiusMm" ValueChanged="@(v => PatchAsync(s.Id!, new { radiusMm = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        }
                        <label class="ib-designer__colour">Fill
                            <input type="color" value="@(s.Fill is { Length: 7 } f && f[0] == '#' ? f : "#99D5CF")" @onchange="@(e => PatchAsync(s.Id!, new { fill = e.Value?.ToString() }))" />
                        </label>
                        <label class="ib-designer__colour">Border colour
                            <input type="color" value="@(s.Stroke is { Length: 7 } b && b[0] == '#' ? b : "#0F172A")" @onchange="@(e => PatchAsync(s.Id!, new { stroke = e.Value?.ToString() }))" />
                        </label>
                        <MudNumericField T="double" Label="Border width (mm)" Min="0" Step="0.1" Value="s.StrokeWidthMm" ValueChanged="@(v => PatchAsync(s.Id!, new { strokeWidthMm = v }))" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    }
                    @if (s.Kind == "el" && (s.Type == "field" || s.Type == "image"))
                    {
                        <MudSelect T="string" Label="Bound field" Value="s.Binding" ValueChanged="@(v => PatchAsync(s.Id!, new { binding = v }))" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var b in TemplateBindings.Allowed.Order(StringComparer.Ordinal))
                            {
                                <MudSelectItem T="string" Value="@b">@b</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    @if (IsTextBased(s))
                    {
                        <div role="group" aria-label="Text alignment" style="display:flex; gap:8px;">
                            @foreach (var (value, label) in Alignments)
                            {
                                var a = value;
                                <MudButton Variant="@(CurrentAlign(s) == a ? Variant.Filled : Variant.Outlined)" Style="min-width:44px; min-height:44px;" aria-pressed="@(CurrentAlign(s) == a ? "true" : "false")" aria-label="@($"Align {label.ToLowerInvariant()}")" OnClick="@(() => PatchAsync(s.Id!, new { align = a }))">@label</MudButton>
                            }
                        </div>
                    }
                    @if (s.Kind == "el")
                    {
                        <MudSelect T="string" Label="Repeat" Value="s.Repeat" ValueChanged="@(v => PatchAsync(s.Id!, new { repeat = v }))" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@("first")">First page only</MudSelectItem>
                            <MudSelectItem T="string" Value="@("all")">Every page</MudSelectItem>
                            <MudSelectItem T="string" Value="@("last")">Last page only</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => CallAsync("duplicate"))">Duplicate</MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => CallAsync("centreHorizontally"))">Centre horizontally</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => CallAsync("remove"))">Delete</MudButton>
                }
                else
                {
                    <p class="ib-help">Select an element to edit it. Arrow keys nudge 1 mm (Shift = 5 mm); Delete removes; Ctrl+Z / Ctrl+Y undo and redo; Ctrl+D duplicates.</p>
                }
                <h2 class="ib-designer__h">Theme</h2>
                <p class="ib-help">Uses theme tokens, so a theme swap restyles it.</p>
                <div class="ib-designer__swatches">
                    @foreach (var t in _template.ThemeTokens)
                    {
                        <span class="ib-designer__swatch" style="background:@t.Value" title="@t.Key"></span>
                    }
                </div>
            </aside>
        </div>
    </div>
}

@code {
    private static readonly (string Key, string Label)[] Inserts =
    [
        ("text", "Text"), ("image", "Image / logo"), ("shape", "Shape"), ("field", "Data field"),
        ("line", "Line"),
                ("notes", "Notes"), ("terms", "Terms"), ("bank", "Bank details"), ("business", "Business address"),
                ("status", "Status"), ("stamp", "Status stamp"),
    ];

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private TemplateForDesign? _template;
    private string? _error;
    private DesignerState _state = new();
    private DotNetObjectReference<TemplateCanvas>? _ref;
    private bool _initialised;
    private bool _busy;
    private bool _saved;
    private bool _preview;
    private string? _previewHtml;
    private string _zoom = "fit";

    private static readonly (string Value, string Label)[] Alignments = [("left", "Left"), ("center", "Centre"), ("right", "Right")];

    private static bool IsTextBased(SelectedInfo s) =>
        s.Type is "text" or "field" or "signature";

    private static string CurrentAlign(SelectedInfo s) => s.Align ?? "left";

    private static string WidthLabel(SelectedInfo s) => s.Type == "line" ? "Length (mm)" : "W (mm)";

    [Parameter]
    public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetTemplateForDesignQuery(Id));
        if (result.IsFailure)
        {
            _error = result.Error.Message;
            return;
        }

        _template = result.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_template is null || _initialised)
        {
            return;
        }

        _initialised = true;
        _ref = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("IbDesigner.init", "ib-designer-canvas", "ib-designer-host", _ref, _template.DefinitionJson);
        _jsInitialized = true;
    }

    [JSInvokable]
    public Task OnDesignerState(string json)
    {
        _state = JsonSerializer.Deserialize<DesignerState>(json, JsonOptions) ?? new();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CallAsync(string method, params object?[] args) =>
        await Js.InvokeVoidAsync("IbDesigner." + method, args);

    private string? _dragId;

    private async Task DropLayerAsync(string targetId)
    {
        var id = _dragId;
        _dragId = null;
        if (id is not null && id != targetId)
        {
            await CallAsync("moveLayer", id, targetId);
        }
    }

    private Task PatchAsync(string id, object changes) => CallAsync("patch", id, changes);
    private Task GeoAsync(object changes) => CallAsync("setGeometry", changes);

    private Task LayerAsync(string layer) => CallAsync("setLayer", layer);

    private async Task ZoomAsync(string zoom)
    {
        _zoom = zoom;
        await CallAsync("setZoom", zoom);
    }

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var json = await Js.InvokeAsync<string>("IbDesigner.getJson");
            var result = await Sender.Send(new SaveTemplateDraftCommand(Id, json));
            if (result.IsFailure)
            {
                Snackbar.Add(result.Error.Message, Severity.Error);
                return;
            }

            _saved = true;
            await ReloadTemplateAsync();
            await CallAsync("markSaved");
            Snackbar.Add($"Draft v{result.Value} saved.", Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private bool CannotPublish => _busy || _state.Dirty || _template?.DraftVersion is null;

    private string PublishLabel => _template?.DraftVersion is int draft ? $"Publish v{draft}" : "Publish";

    private async Task ReloadTemplateAsync()
    {
        var reloaded = await Sender.Send(new GetTemplateForDesignQuery(Id));
        if (reloaded.IsSuccess)
        {
            _template = reloaded.Value;
        }
    }

    private async Task PublishAsync()
    {
        if (_template?.DraftVersion is not { } version)
        {
            return;
        }

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            $"Publish v{version}?",
            "New documents will use it. Issued documents keep their version.",
            yesText: "Publish",
            cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Sender.Send(new PublishTemplateCommand(Id));
            if (result.IsFailure)
            {
                Snackbar.Add(result.Error.Message, Severity.Error);
                return;
            }

            await ReloadTemplateAsync();
            Snackbar.Add($"Published v{result.Value}.", Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TogglePreviewAsync()
    {
        if (_preview)
        {
            _preview = false;
            return;
        }

        var json = await Js.InvokeAsync<string>("IbDesigner.getJson");
        var result = await Sender.Send(new PreviewTemplateQuery(Id, json));
        if (result.IsFailure)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }

        _previewHtml = result.Value;
        _preview = true;
    }

    private static string Trim(string? s) => s ?? string.Empty;

    private bool _jsInitialized;

    public async ValueTask DisposeAsync()
    {
        // Prerender-disposed instances never ran OnAfterRenderAsync; JS interop is unavailable then.
        if (!_jsInitialized)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("IbDesigner.dispose");
        }
        catch (JSDisconnectedException)
        {
        }

        _ref?.Dispose();
    }

    private sealed class DesignerState
    {
        public List<LayerInfo> Layers { get; set; } = [];

        public SelectedInfo? Selected { get; set; }

        public string Layer { get; set; } = "first";

        public bool Dirty { get; set; }

        public bool CanUndo { get; set; }

        public bool CanRedo { get; set; }
    }

    private sealed class LayerInfo
    {
        public string Id { get; set; } = string.Empty;

        public string Type { get; set; } = string.Empty;

        public string? Label { get; set; }

        public bool Locked { get; set; }

        public bool Hidden { get; set; }
    }

    private sealed class SelectedInfo
    {
        public string Kind { get; set; } = "el";

        public string? Id { get; set; }

        public string? Type { get; set; }

        public double XMm { get; set; }

        public double YMm { get; set; }

        public double WidthMm { get; set; }

        public double HeightMm { get; set; }

        public double Rotation { get; set; }

        public double Opacity { get; set; } = 1;

        public string? Text { get; set; }

        public string? Align { get; set; }

        public string? Binding { get; set; }
        public string? Repeat { get; set; }

        public string? Shape { get; set; }

        public string? Fill { get; set; }

        public string? Stroke { get; set; }

        public double StrokeWidthMm { get; set; }

        public double RadiusMm { get; set; }
    }
}
