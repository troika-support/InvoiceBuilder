@using InvoiceBuilder.Application.Businesses.Settings
@inject MediatR.ISender Sender
@inject InvoiceBuilder.Web.Services.LiveAnnouncer Announcer

<MudDialog aria-labelledby="reset-password-title">
    <TitleContent>
        <h2 id="reset-password-title" class="ib-section-title">Reset password for @MemberName</h2>
    </TitleContent>
    <DialogContent>
        @if (_formError is not null)
        {
            <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_formError</MudAlert>
        }
        <MudTextField @bind-Value="_password" Label="New password" InputType="InputType.Password" Required="true" Variant="Variant.Outlined" AutoFocus="true"
                      UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                      HelperText="At least 12 characters. Share it with them yourself." />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">Reset password</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string UserId { get; set; } = "";

    [Parameter] public string MemberName { get; set; } = "";

    private string _password = "";
    private string? _formError;
    private bool _saving;

    private void Cancel() => Dialog.Cancel();

    private async Task SaveAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            var result = await Sender.Send(new ResetTeamMemberPasswordCommand(UserId, _password));
            if (result.IsFailure)
            {
                _formError = result.Error.Message;
                Announcer.Announce(result.Error.Message);
                return;
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _saving = false;
        }
    }
}
