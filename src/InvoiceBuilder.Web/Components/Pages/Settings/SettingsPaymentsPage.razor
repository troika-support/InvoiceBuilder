@page "/settings/payments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Owner")]
@using InvoiceBuilder.Application.Businesses.Settings
@using InvoiceBuilder.Domain.ValueObjects
@inject MediatR.ISender Sender
@inject InvoiceBuilder.Web.Services.LiveAnnouncer Announcer

<PageTitle>Payment methods · Settings · Invoice Builder</PageTitle>

<h1 class="ib-page-title">Business settings</h1>
<div class="ib-settings">
    <SettingsNav />
    <section class="ib-settings__body" aria-labelledby="section-title">
        <h2 id="section-title" class="ib-section-title">Payment methods</h2>

        @if (_loadError is not null)
        {
            <EmptyState Title="@_loadError" Message="Add a business or pick one in the sidebar." />
        }
        else if (_model is null)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Loading settings" />
        }
        else
        {
            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_formError</MudAlert>
            }

            <p class="ib-help" style="margin-top:0;">
                Paynow gives you a separate integration ID and key for each currency. Set up the currencies you bill in.
                Invoices in a currency with no integration show your bank details instead of a pay button.
            </p>

            @foreach (var integration in _model.Integrations)
            {
                var prefix = integration.FieldPrefix;
                <div class="ib-card" style="padding: 20px; margin-bottom: 16px;" @key="prefix">
                    <h3 class="ib-card__title">Paynow · @integration.Currency.DisplayText</h3>
                    <div class="ib-form-grid">
                        <MudTextField @bind-Value="integration.IntegrationId" Label="@($"{integration.Currency.DisplayText} integration ID")" Variant="Variant.Outlined"
                                      Error="@HasError(prefix + ".IntegrationId")" ErrorText="@ErrorFor(prefix + ".IntegrationId")" />
                        <MudTextField @bind-Value="integration.NewKey" Label="@($"{integration.Currency.DisplayText} integration key")" InputType="InputType.Password"
                                      Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                                      Placeholder="@(integration.KeySaved ? "Saved ••••" : null)"
                                      HelperText="@(integration.KeySaved ? "Saved ••••. Leave blank to keep it, or type a new key to replace it." : $"Paste the key of your {integration.Currency.DisplayText} integration from your Paynow account.")"
                                      Error="@HasError(prefix + ".NewIntegrationKey")" ErrorText="@ErrorFor(prefix + ".NewIntegrationKey")" />
                    </div>
                    <MudSwitch T="bool" @bind-Value="integration.IsLive" Color="Color.Primary" Label="@(integration.IsLive ? "Live: real payments" : "Test mode: no real money moves")" />
                    <div style="display:flex; gap:12px; align-items:center; margin-top:8px;">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => TestAsync(integration))" Disabled="@(integration.Testing || !integration.KeySaved)">Test connection</MudButton>
                        @if (integration.TestMessage is not null)
                        {
                            <span role="status" class="@(integration.TestOk ? "ib-help" : "ib-field-error")">@integration.TestMessage</span>
                        }
                    </div>
                </div>
            }
            <p class="ib-help">Test connection checks the saved key can sign requests. It starts no payment and sends nothing to Paynow.</p>

            <div class="ib-card" style="padding: 20px; margin-top: 16px;">
                <h3 class="ib-card__title">Bank transfer details</h3>
                <MudTextField @bind-Value="_model.BankDetails" Label="Bank details" Lines="4" Variant="Variant.Outlined"
                              HelperText="Shown to clients who pay by bank transfer, and when online payment isn't available."
                              Error="@HasError("BankDetails")" ErrorText="@ErrorFor("BankDetails")" />
            </div>

            <div class="ib-settings__footer" style="margin-top: 16px;">
                <MudButton Variant="Variant.Text" OnClick="DiscardAsync" Disabled="_saving">Discard</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">Save changes</MudButton>
            </div>
        }
    </section>
</div>

@code {
    private Model? _model;
    private string? _loadError;
    private string? _formError;
    private bool _saving;
    private IReadOnlyDictionary<string, string[]> _fieldErrors = new Dictionary<string, string[]>();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Sender.Send(new GetPaymentSettingsQuery());
        if (result.IsFailure)
        {
            _loadError = "No business selected";
            _model = null;
            return;
        }

        _loadError = null;
        _model = new Model
        {
            Integrations =
            [
                IntegrationModel.From(CurrencyCode.Usd, "Usd", result.Value.Usd),
                IntegrationModel.From(CurrencyCode.Zwg, "Zwg", result.Value.Zwg),
            ],
            BankDetails = result.Value.BankDetails,
        };
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        _formError = null;
        _fieldErrors = new Dictionary<string, string[]>();
        foreach (var integration in _model.Integrations)
        {
            integration.TestMessage = null;
        }

        try
        {
            var command = new UpdatePaymentSettingsCommand(
                _model.Integrations[0].ToInput(),
                _model.Integrations[1].ToInput(),
                _model.BankDetails ?? string.Empty);
            var result = await Sender.Send(command);
            if (result.IsFailure)
            {
                _fieldErrors = result.Error.FieldErrors ?? new Dictionary<string, string[]>();
                _formError = result.Error.Message;
                Announcer.Announce(result.Error.Message);
                return;
            }

            Announcer.Toast("Settings saved", Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestAsync(IntegrationModel integration)
    {
        integration.Testing = true;
        try
        {
            var result = await Sender.Send(new TestPaynowConnectionCommand(integration.Currency));
            integration.TestOk = result.IsSuccess;
            integration.TestMessage = result.IsSuccess
                ? $"{integration.Currency.DisplayText} connection settings look good."
                : result.Error.Message;
            Announcer.Announce(integration.TestMessage);
        }
        finally
        {
            integration.Testing = false;
        }
    }

    private async Task DiscardAsync()
    {
        _formError = null;
        _fieldErrors = new Dictionary<string, string[]>();
        await LoadAsync();
        Announcer.Announce("Changes discarded");
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? ErrorFor(string field) => _fieldErrors.TryGetValue(field, out var messages) ? string.Join(" ", messages) : null;

    private sealed class Model
    {
        public required IReadOnlyList<IntegrationModel> Integrations { get; init; }
        public string? BankDetails { get; set; }
    }

    private sealed class IntegrationModel
    {
        public required CurrencyCode Currency { get; init; }
        public required string FieldPrefix { get; init; }
        public string? IntegrationId { get; set; }
        public string? NewKey { get; set; }
        public bool KeySaved { get; init; }
        public bool IsLive { get; set; }
        public bool Testing { get; set; }
        public bool TestOk { get; set; }
        public string? TestMessage { get; set; }

        public static IntegrationModel From(CurrencyCode currency, string fieldPrefix, PaynowIntegrationSettings saved) => new()
        {
            Currency = currency,
            FieldPrefix = fieldPrefix,
            IntegrationId = saved.IntegrationId,
            KeySaved = saved.KeySaved,
            IsLive = saved.IsLive,
        };

        public PaynowIntegrationInput ToInput() => new(IntegrationId ?? string.Empty, NewKey, IsLive);
    }
}
