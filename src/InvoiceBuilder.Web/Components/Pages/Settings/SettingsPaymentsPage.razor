@page "/settings/payments"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Owner")]
@using InvoiceBuilder.Application.Businesses.Settings
@inject MediatR.ISender Sender
@inject InvoiceBuilder.Web.Services.LiveAnnouncer Announcer

<PageTitle>Payment methods · Settings · Invoice Builder</PageTitle>

<h1 class="ib-page-title">Business settings</h1>
<div class="ib-settings">
    <SettingsNav />
    <section class="ib-settings__body" aria-labelledby="section-title">
        <h2 id="section-title" class="ib-section-title">Payment methods</h2>

        @if (_loadError is not null)
        {
            <EmptyState Title="@_loadError" Message="Add a business or pick one in the sidebar." />
        }
        else if (_model is null)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Loading settings" />
        }
        else
        {
            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_formError</MudAlert>
            }

            <div class="ib-card" style="padding: 20px;">
                <h3 class="ib-card__title">Paynow</h3>
                <div class="ib-form-grid">
                    <MudTextField @bind-Value="_model.IntegrationId" Label="Integration ID" Variant="Variant.Outlined" Error="@HasError("PaynowIntegrationId")" ErrorText="@ErrorFor("PaynowIntegrationId")" />
                    <MudTextField @bind-Value="_model.NewKey" Label="Integration key" InputType="InputType.Password"
                                  Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                                  Placeholder="@(_model.KeySaved ? "Saved ••••" : null)"
                                  HelperText="@(_model.KeySaved ? "Saved ••••. Leave blank to keep it, or type a new key to replace it." : "Paste the key from your Paynow account.")"
                                  Error="@HasError("NewIntegrationKey")" ErrorText="@ErrorFor("NewIntegrationKey")" />
                </div>
                <MudSwitch T="bool" @bind-Value="_model.IsLive" Color="Color.Primary" Label="@(_model.IsLive ? "Live: real payments" : "Test mode: no real money moves")" />
                <div style="display:flex; gap:12px; align-items:center; margin-top:8px;">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="TestAsync" Disabled="@(_testing || !_model.KeySaved)">Test connection</MudButton>
                    @if (_testMessage is not null)
                    {
                        <span role="status" class="@(_testOk ? "ib-help" : "ib-field-error")">@_testMessage</span>
                    }
                </div>
                <p class="ib-help">Test connection checks the saved key can sign requests. It starts no payment and sends nothing to Paynow.</p>
            </div>

            <div class="ib-card" style="padding: 20px; margin-top: 16px;">
                <h3 class="ib-card__title">Bank transfer details</h3>
                <MudTextField @bind-Value="_model.BankDetails" Label="Bank details" Lines="4" Variant="Variant.Outlined"
                              HelperText="Shown to clients who pay by bank transfer, and when online payment isn't available."
                              Error="@HasError("BankDetails")" ErrorText="@ErrorFor("BankDetails")" />
            </div>

            <div class="ib-settings__footer" style="margin-top: 16px;">
                <MudButton Variant="Variant.Text" OnClick="DiscardAsync" Disabled="_saving">Discard</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">Save changes</MudButton>
            </div>
        }
    </section>
</div>

@code {
    private Model? _model;
    private string? _loadError;
    private string? _formError;
    private string? _testMessage;
    private bool _testOk;
    private bool _testing;
    private bool _saving;
    private IReadOnlyDictionary<string, string[]> _fieldErrors = new Dictionary<string, string[]>();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Sender.Send(new GetPaymentSettingsQuery());
        if (result.IsFailure)
        {
            _loadError = "No business selected";
            _model = null;
            return;
        }

        _loadError = null;
        _model = new Model
        {
            IntegrationId = result.Value.PaynowIntegrationId,
            KeySaved = result.Value.PaynowKeySaved,
            IsLive = result.Value.IsLive,
            BankDetails = result.Value.BankDetails,
        };
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        _formError = null;
        _testMessage = null;
        _fieldErrors = new Dictionary<string, string[]>();
        try
        {
            var result = await Sender.Send(new UpdatePaymentSettingsCommand(_model.IntegrationId ?? string.Empty, _model.NewKey, _model.IsLive, _model.BankDetails ?? string.Empty));
            if (result.IsFailure)
            {
                _fieldErrors = result.Error.FieldErrors ?? new Dictionary<string, string[]>();
                _formError = result.Error.Message;
                Announcer.Announce(result.Error.Message);
                return;
            }

            Announcer.Toast("Settings saved", Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TestAsync()
    {
        _testing = true;
        try
        {
            var result = await Sender.Send(new TestPaynowConnectionCommand());
            _testOk = result.IsSuccess;
            _testMessage = result.IsSuccess ? "Connection settings look good." : result.Error.Message;
            Announcer.Announce(_testMessage);
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task DiscardAsync()
    {
        _formError = null;
        _testMessage = null;
        _fieldErrors = new Dictionary<string, string[]>();
        await LoadAsync();
        Announcer.Announce("Changes discarded");
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? ErrorFor(string field) => _fieldErrors.TryGetValue(field, out var messages) ? string.Join(" ", messages) : null;

    private sealed class Model
    {
        public string? IntegrationId { get; set; }
        public string? NewKey { get; set; }
        public bool KeySaved { get; init; }
        public bool IsLive { get; set; }
        public string? BankDetails { get; set; }
    }
}
