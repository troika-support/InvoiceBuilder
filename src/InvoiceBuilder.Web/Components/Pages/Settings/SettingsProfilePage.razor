@page "/settings/profile"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Owner")]
@using InvoiceBuilder.Application.Businesses.Settings
@using InvoiceBuilder.Domain.Businesses
@using InvoiceBuilder.Domain.Documents
@inject MediatR.ISender Sender
@inject InvoiceBuilder.Web.Services.LiveAnnouncer Announcer
@inject InvoiceBuilder.Web.Services.ShellState Shell
@inject IDialogService Dialogs

<PageTitle>Profile &amp; numbering · Settings · Invoice Builder</PageTitle>

<div class="ib-page-header">
    <h1 class="ib-page-title">Business settings</h1>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="AddBusinessAsync">+ Add a business</MudButton>
</div>

<div class="ib-settings">
    <SettingsNav />
    <section class="ib-settings__body" aria-labelledby="section-title">
        <h2 id="section-title" class="ib-section-title">Profile &amp; numbering</h2>

        @if (_loadError is not null)
        {
            <EmptyState Title="@_loadError" Message="Add a business or pick one in the sidebar." ActionText="+ Add a business" OnAction="AddBusinessAsync" />
        }
        else if (_model is null)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Loading settings" />
        }
        else
        {
            <EditForm Model="_model" OnSubmit="SaveAsync" FormName="business-profile">
                @if (_formError is not null)
                {
                    <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_formError</MudAlert>
                }

                <div class="ib-card" style="padding: 20px;">
                    <h3 class="ib-card__title">Profile</h3>
                    <div class="ib-logo-row">
                        <div class="ib-logo-tile">
                            @if (LogoDataUrl is { } src)
                            {
                                <img src="@src" alt="Current logo" />
                            }
                            else
                            {
                                <span aria-hidden="true">Logo</span>
                            }
                        </div>
                        <div class="ib-logo-actions">
                            <label class="ib-file-button" for="logo-input">@(LogoDataUrl is null ? "Upload logo" : "Replace")</label>
                            <InputFile id="logo-input" class="ib-visually-hidden" accept="image/png,image/svg+xml" OnChange="LogoSelectedAsync" aria-describedby="logo-help" />
                            @if (LogoDataUrl is not null)
                            {
                                <MudButton Variant="Variant.Text" OnClick="RemoveLogo">Remove</MudButton>
                            }
                            <span id="logo-help" class="ib-help">PNG or SVG, up to 1 MB.</span>
                            @if (_logoError is not null)
                            {
                                <span class="ib-field-error" role="alert">@_logoError</span>
                            }
                        </div>
                    </div>

                    <div class="ib-form-grid">
                        <MudTextField @bind-Value="_model.TradingName" Label="Trading name" Required="true" Variant="Variant.Outlined" Error="@HasError("TradingName")" ErrorText="@ErrorFor("TradingName")" />
                        <MudTextField @bind-Value="_model.RegisteredName" Label="Registered name" Variant="Variant.Outlined" Error="@HasError("RegisteredName")" ErrorText="@ErrorFor("RegisteredName")" />
                        <MudTextField @bind-Value="_model.Email" Label="Email" InputType="InputType.Email" Required="true" Variant="Variant.Outlined" Error="@HasError("Email")" ErrorText="@ErrorFor("Email")" />
                        <MudTextField @bind-Value="_model.WhatsAppNumber" Label="WhatsApp number" InputType="InputType.Telephone" Variant="Variant.Outlined" HelperText="With country code, for example +263 77 123 4567" Error="@HasError("WhatsAppNumber")" ErrorText="@ErrorFor("WhatsAppNumber")" />
                        <MudTextField @bind-Value="_model.Address" Label="Address" Lines="3" Variant="Variant.Outlined" Class="ib-form-grid__wide" Error="@HasError("Address")" ErrorText="@ErrorFor("Address")" />
                    </div>
                </div>

                <div class="ib-card" style="padding: 20px; margin-top: 16px;">
                    <h3 class="ib-card__title">Numbering</h3>
                    <p class="ib-help" style="margin-top: 0;">Prefix changes apply to new numbers only. Issued documents keep their numbers.</p>
                    <table class="ib-table">
                        <thead>
                            <tr>
                                <th scope="col">Document</th>
                                <th scope="col">Prefix</th>
                                <th scope="col">Next number</th>
                                <th scope="col">Example</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _model.Numbering)
                            {
                                <tr>
                                    <th scope="row">@DocumentLabel(row.DocumentType)</th>
                                    <td>
                                        <MudTextField @bind-Value="row.Prefix" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      MaxLength="NumberSequence.MaxPrefixLength" aria-label="@($"{DocumentLabel(row.DocumentType)} prefix")"
                                                      Error="@(PrefixError(row.Prefix) is not null)" ErrorText="@PrefixError(row.Prefix)" />
                                    </td>
                                    <td class="ib-mono">@row.NextValue</td>
                                    <td class="ib-mono">@Example(row)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="ib-card ib-card--dashed" style="padding: 20px; margin-top: 16px;">
                    <div class="ib-later">
                        <h3 class="ib-card__title" style="margin: 0;">ZIMRA fiscalisation</h3>
                        <span class="ib-badge">Later</span>
                    </div>
                    <MudSwitch T="bool" Value="false" Disabled="true" Label="Fiscalise invoices with FDMS" />
                </div>

                <div class="ib-settings__footer" style="margin-top: 16px;">
                    <MudButton Variant="Variant.Text" OnClick="DiscardAsync" Disabled="_saving">Discard</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">Save changes</MudButton>
                </div>
            </EditForm>
        }
    </section>
</div>

@code {
    private ProfileModel? _model;
    private string? _loadError;
    private string? _formError;
    private string? _logoError;
    private bool _saving;
    private IReadOnlyDictionary<string, string[]> _fieldErrors = new Dictionary<string, string[]>();

    private string? LogoDataUrl => _model switch
    {
        { RemoveLogo: true } => null,
        { NewLogo: { } bytes, NewLogoType: { } type } => $"data:{type};base64,{Convert.ToBase64String(bytes)}",
        { Logo: { } bytes, LogoType: { } type } => $"data:{type};base64,{Convert.ToBase64String(bytes)}",
        _ => null,
    };

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Sender.Send(new GetBusinessProfileQuery());
        if (result.IsFailure)
        {
            _loadError = "No business selected";
            _model = null;
            return;
        }

        _loadError = null;
        _model = ProfileModel.From(result.Value);
    }

    private async Task LogoSelectedAsync(InputFileChangeEventArgs e)
    {
        _logoError = null;
        var file = e.File;
        if (file.ContentType is not ("image/png" or "image/svg+xml"))
        {
            _logoError = "Upload a PNG or SVG logo.";
            return;
        }

        if (file.Size > Business.MaxLogoBytes)
        {
            _logoError = "The logo must be 1 MB or smaller.";
            return;
        }

        await using var stream = file.OpenReadStream(Business.MaxLogoBytes);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        _model!.NewLogo = buffer.ToArray();
        _model.NewLogoType = file.ContentType;
        _model.RemoveLogo = false;
        Announcer.Announce("Logo ready. Save changes to keep it.");
    }

    private void RemoveLogo()
    {
        _model!.NewLogo = null;
        _model.NewLogoType = null;
        _model.RemoveLogo = true;
    }

    private async Task SaveAsync()
    {
        if (_model is null || _model.Numbering.Any(r => PrefixError(r.Prefix) is not null))
        {
            _formError = "Some fields need fixing.";
            return;
        }

        _saving = true;
        _formError = null;
        _fieldErrors = new Dictionary<string, string[]>();
        try
        {
            LogoChange? logo = _model.RemoveLogo
                ? new LogoChange(null, null, true)
                : _model.NewLogo is not null ? new LogoChange(_model.NewLogo, _model.NewLogoType, false) : null;

            var result = await Sender.Send(new UpdateBusinessProfileCommand(
                _model.TradingName,
                _model.RegisteredName,
                _model.Email,
                _model.WhatsAppNumber,
                _model.Address,
                logo,
                _model.Numbering.ToDictionary(r => r.DocumentType, r => r.Prefix.Trim())));

            if (result.IsFailure)
            {
                _fieldErrors = result.Error.FieldErrors ?? new Dictionary<string, string[]>();
                _formError = result.Error.Message;
                Announcer.Announce(result.Error.Message);
                return;
            }

            Announcer.Toast("Settings saved", Severity.Success);
            await Shell.LoadAsync();
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DiscardAsync()
    {
        _formError = null;
        _logoError = null;
        _fieldErrors = new Dictionary<string, string[]>();
        await LoadAsync();
        Announcer.Announce("Changes discarded");
    }

    private async Task AddBusinessAsync()
    {
        var dialog = await Dialogs.ShowAsync<AddBusinessDialog>("Add a business");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? ErrorFor(string field) => _fieldErrors.TryGetValue(field, out var messages) ? string.Join(" ", messages) : null;

    private static string? PrefixError(string? prefix) =>
        string.IsNullOrWhiteSpace(prefix) ? "Enter a prefix."
        : prefix.Any(char.IsWhiteSpace) ? "Prefixes can't contain spaces."
        : prefix.Length > NumberSequence.MaxPrefixLength ? $"Use at most {NumberSequence.MaxPrefixLength} characters."
        : null;

    private static string Example(NumberingRowModel row) =>
        $"{row.Prefix?.Trim()}{row.NextValue.ToString(System.Globalization.CultureInfo.InvariantCulture).PadLeft(row.Padding, '0')}";

    private static string DocumentLabel(DocumentType type) => type switch
    {
        DocumentType.Quote => "Quote",
        DocumentType.Invoice => "Invoice",
        DocumentType.Receipt => "Receipt",
        DocumentType.CreditNote => "Credit note",
        _ => type.ToString(),
    };

    private sealed class ProfileModel
    {
        public string TradingName { get; set; } = "";
        public string RegisteredName { get; set; } = "";
        public string Email { get; set; } = "";
        public string? WhatsAppNumber { get; set; }
        public string Address { get; set; } = "";
        public byte[]? Logo { get; init; }
        public string? LogoType { get; init; }
        public byte[]? NewLogo { get; set; }
        public string? NewLogoType { get; set; }
        public bool RemoveLogo { get; set; }
        public List<NumberingRowModel> Numbering { get; init; } = [];

        public static ProfileModel From(BusinessProfile p) => new()
        {
            TradingName = p.TradingName,
            RegisteredName = p.RegisteredName,
            Email = p.Email,
            WhatsAppNumber = p.WhatsAppNumber,
            Address = p.Address,
            Logo = p.Logo,
            LogoType = p.LogoContentType,
            Numbering = p.Numbering.Select(n => new NumberingRowModel { DocumentType = n.DocumentType, Prefix = n.Prefix, NextValue = n.NextValue, Padding = n.Padding }).ToList(),
        };
    }

    private sealed class NumberingRowModel
    {
        public DocumentType DocumentType { get; init; }
        public string Prefix { get; set; } = "";
        public long NextValue { get; init; }
        public int Padding { get; init; }
    }
}
