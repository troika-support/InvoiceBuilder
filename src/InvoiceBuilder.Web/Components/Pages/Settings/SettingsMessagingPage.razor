@page "/settings/messaging"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Owner")]
@using InvoiceBuilder.Application.Businesses.Settings
@inject MediatR.ISender Sender
@inject InvoiceBuilder.Web.Services.LiveAnnouncer Announcer

<PageTitle>Email &amp; WhatsApp · Settings · Invoice Builder</PageTitle>

<h1 class="ib-page-title">Business settings</h1>
<div class="ib-settings">
    <SettingsNav />
    <section class="ib-settings__body" aria-labelledby="section-title">
        <h2 id="section-title" class="ib-section-title">Email &amp; WhatsApp</h2>

        @if (_loadError is not null)
        {
            <EmptyState Title="@_loadError" Message="Add a business or pick one in the sidebar." />
        }
        else if (_model is null)
        {
            <MudProgressLinear Indeterminate="true" aria-label="Loading settings" />
        }
        else
        {
            @if (_formError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert" Class="mb-4">@_formError</MudAlert>
            }

            <div class="ib-card" style="padding: 20px;">
                <h3 class="ib-card__title">Email</h3>
                <div class="ib-form-grid">
                    <MudTextField @bind-Value="_model.EmailFromName" Label="From name" Variant="Variant.Outlined" HelperText="Clients see this as the sender."
                                  Error="@HasError("EmailFromName")" ErrorText="@ErrorFor("EmailFromName")" />
                    <MudTextField @bind-Value="_model.EmailReplyTo" Label="Reply-to email" InputType="InputType.Email" Variant="Variant.Outlined"
                                  Error="@HasError("EmailReplyTo")" ErrorText="@ErrorFor("EmailReplyTo")" />
                </div>
            </div>

            <div class="ib-card" style="padding: 20px; margin-top: 16px;">
                <h3 class="ib-card__title">WhatsApp</h3>
                <div class="ib-form-grid">
                    <MudTextField @bind-Value="_model.PhoneNumberId" Label="Phone number ID" Variant="Variant.Outlined" HelperText="From your Meta WhatsApp Business app."
                                  Error="@HasError("WhatsAppPhoneNumberId")" ErrorText="@ErrorFor("WhatsAppPhoneNumberId")" />
                    <MudTextField @bind-Value="_model.NewToken" Label="Access token" InputType="InputType.Password"
                                  Variant="Variant.Outlined" UserAttributes="@(new Dictionary<string, object?> { ["autocomplete"] = "new-password" })"
                                  Placeholder="@(_model.TokenSaved ? "Saved ••••" : null)"
                                  HelperText="@(_model.TokenSaved ? "Saved ••••. Leave blank to keep it, or type a new token to replace it." : "Paste the token from Meta.")"
                                  Error="@HasError("NewWhatsAppToken")" ErrorText="@ErrorFor("NewWhatsAppToken")" />
                </div>
                @if (_model.TokenSaved)
                {
                    <MudCheckBox T="bool" @bind-Value="_model.RemoveToken" Label="Remove the saved token" />
                }
            </div>

            <div class="ib-settings__footer" style="margin-top: 16px;">
                <MudButton Variant="Variant.Text" OnClick="DiscardAsync" Disabled="_saving">Discard</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">Save changes</MudButton>
            </div>
        }
    </section>
</div>

@code {
    private Model? _model;
    private string? _loadError;
    private string? _formError;
    private bool _saving;
    private IReadOnlyDictionary<string, string[]> _fieldErrors = new Dictionary<string, string[]>();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Sender.Send(new GetMessagingSettingsQuery());
        if (result.IsFailure)
        {
            _loadError = "No business selected";
            _model = null;
            return;
        }

        _loadError = null;
        _model = new Model
        {
            EmailFromName = result.Value.EmailFromName,
            EmailReplyTo = result.Value.EmailReplyTo,
            PhoneNumberId = result.Value.WhatsAppPhoneNumberId,
            TokenSaved = result.Value.WhatsAppTokenSaved,
        };
    }

    private async Task SaveAsync()
    {
        if (_model is null)
        {
            return;
        }

        _saving = true;
        _formError = null;
        _fieldErrors = new Dictionary<string, string[]>();
        try
        {
            var result = await Sender.Send(new UpdateMessagingSettingsCommand(
                _model.EmailFromName ?? string.Empty, _model.EmailReplyTo, _model.PhoneNumberId, _model.NewToken, _model.RemoveToken));
            if (result.IsFailure)
            {
                _fieldErrors = result.Error.FieldErrors ?? new Dictionary<string, string[]>();
                _formError = result.Error.Message;
                Announcer.Announce(result.Error.Message);
                return;
            }

            Announcer.Toast("Settings saved", Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DiscardAsync()
    {
        _formError = null;
        _fieldErrors = new Dictionary<string, string[]>();
        await LoadAsync();
        Announcer.Announce("Changes discarded");
    }

    private bool HasError(string field) => _fieldErrors.ContainsKey(field);

    private string? ErrorFor(string field) => _fieldErrors.TryGetValue(field, out var messages) ? string.Join(" ", messages) : null;

    private sealed class Model
    {
        public string? EmailFromName { get; set; }
        public string? EmailReplyTo { get; set; }
        public string? PhoneNumberId { get; set; }
        public string? NewToken { get; set; }
        public bool TokenSaved { get; init; }
        public bool RemoveToken { get; set; }
    }
}
