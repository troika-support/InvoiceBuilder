a, .btn-link {
    color: #006bb7;
}

.btn-primary {
    color: #fff;
    background-color: #1b6ec2;
    border-color: #1861ac;
}

.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {
  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;
}

.content {
    padding-top: 1.1rem;
}

h1:focus {
    outline: none;
}

.valid.modified:not([type=checkbox]) {
    outline: 1px solid #26b050;
}

.invalid {
    outline: 1px solid #e50000;
}

.validation-message {
    color: #e50000;
}

.blazor-error-boundary {
    background: url(data:image/svg+xml;base64,) no-repeat 1rem/1.8rem, #b32121;
    padding: 1rem 1rem 1rem 3.7rem;
    color: white;
}

    .blazor-error-boundary::after {
        content: "An error has occurred."
    }

.darker-border-checkbox.form-check-input {
    border-color: #929292;
}

.form-floating > .form-control-plaintext::placeholder, .form-floating > .form-control::placeholder {
    color: var(--bs-secondary-color);
    text-align: end;
}

.form-floating > .form-control-plaintext:focus::placeholder, .form-floating > .form-control:focus::placeholder {
    text-align: start;
}
/* prompt 09: shell top bar (below 960 px) and nav buttons */
.ib-topbar { display: none; }
.ib-shell { color: var(--ib-text); font-family: var(--ib-font); }
.ib-page-title { margin: 0 0 16px; font-size: 26px; line-height: 32px; font-weight: 800; letter-spacing: -0.02em; color: var(--ib-text); }
@media (max-width: 959.98px) {
  .ib-shell { flex-direction: column; flex-wrap: nowrap; }
  .ib-topbar { display: flex; flex: 0 0 auto; min-height: 56px; box-sizing: border-box; position: sticky; top: 0; z-index: 10; align-items: center; gap: 12px; padding: 6px 8px 6px 16px; background: var(--ib-nav-bg); color: var(--ib-nav-text); }
  .ib-nav { flex: 0 0 auto; }
  .ib-main { flex: 1 0 auto; }
  .ib-topbar__title { flex: 1; font-weight: 700; }
}
.ib-topbar__menu { min-width: 44px; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 0; border-radius: 8px; color: inherit; cursor: pointer; }
.ib-nav__button { width: 100%; box-sizing: border-box; justify-content: flex-start; background: transparent; border: 0; font: inherit; color: var(--ib-nav-text); cursor: pointer; text-align: left; }
.ib-nav--rail .ib-nav__button { justify-content: center; }
.ib-nav__footer { margin-top: auto; display: flex; flex-direction: column; gap: 4px; }
.ib-nav form { margin: 0; }
@media (min-width: 960px) {
  .ib-nav { position: sticky; top: 0; height: 100vh; overflow-y: auto; align-self: flex-start; }
}


/* business switcher (DS §7) */
.ib-switcher__tile { width: 32px; height: 32px; flex: none; border-radius: 8px; background: var(--ib-brand-mark); color: #0F172A; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 12px; }
.ib-switcher__text { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.2; }
.ib-switcher__caption { font-size: 12px; color: var(--ib-nav-muted); }
.ib-switcher__name { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.ib-switcher__item { min-height: 44px; padding: 0 12px; border: 0; border-radius: 8px; background: transparent; color: var(--mud-palette-text-primary); font: inherit; font-weight: 600; text-align: left; cursor: pointer; }
.ib-switcher__item:hover, .ib-switcher__item:focus-visible { background: var(--mud-palette-action-default-hover); color: var(--mud-palette-text-primary); }
.ib-switcher__item[aria-current="true"] { background: color-mix(in srgb, var(--mud-palette-primary) 20%, transparent); color: var(--mud-palette-text-primary); }

/* settings (DS §8.10) */
.ib-settings { display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap; }
.ib-settings-nav { flex: 0 0 220px; display: flex; flex-direction: column; gap: 2px; }
.ib-settings-nav__link { display: flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 8px; color: var(--ib-text); text-decoration: none; font-weight: 600; }
.ib-settings-nav__link:hover { background: var(--ib-primary-soft); }
.ib-settings-nav__link[aria-current="page"] { background: var(--ib-primary-soft); color: var(--ib-primary-soft-text); }
.ib-settings__body { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
.ib-section-title { margin: 0; font-size: 18px; line-height: 24px; font-weight: 800; color: var(--ib-text); }
.ib-attention-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.ib-attention-list li { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; min-height: 44px; padding: 8px 12px; border-radius: 8px; background: var(--ib-primary-soft); color: var(--ib-primary-soft-text); }
.ib-attention-list li span { flex: 1 1 240px; }
.ib-attention-list a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 8px; font-weight: 600; color: inherit; text-decoration: underline; }
.ib-attention-list a:focus-visible { outline: 3px solid currentColor; outline-offset: 2px; }
.mud-dialog .ib-section-title, .mud-dialog .ib-page-title, .mud-popover .ib-section-title { color: var(--mud-palette-text-primary); }
.ib-card__title { margin: 0 0 12px; font-size: 16px; font-weight: 700; color: var(--ib-text); }
.ib-settings__footer { display: flex; justify-content: flex-end; gap: 12px; }
.ib-logo-tile { width: 72px; height: 72px; border-radius: 12px; border: 1px solid var(--ib-border); background: var(--ib-surface); display: flex; align-items: center; justify-content: center; overflow: hidden; color: var(--ib-muted); font-weight: 800; }
.ib-logo-tile img { max-width: 100%; max-height: 100%; }
.ib-table { width: 100%; border-collapse: collapse; }
.ib-table th, .ib-table td { text-align: left; padding: 8px; border-bottom: 1px solid var(--ib-border); vertical-align: middle; }
.ib-table th { font-size: 12px; color: var(--ib-muted); font-weight: 700; }
@media (max-width: 959.98px) { .ib-settings-nav { flex-basis: 100%; flex-direction: row; overflow-x: auto; } }
.ib-page-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
.ib-page-header .ib-page-title { margin: 0; }
.ib-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
.ib-form-grid__wide { grid-column: 1 / -1; }
.ib-logo-row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
.ib-logo-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.ib-file-button {
.ib-file-button:hover { background: var(--ib-primary-soft); }
.ib-logo-actions:has(#logo-input:focus-visible) .ib-file-button,
.ib-logo-actions:has(#csv-input:focus-visible) .ib-file-button { outline: 3px solid var(--ib-focus); outline-offset: 2px; }
.ib-help { font-size: 13px; color: var(--ib-muted); }
.ib-editor { display: grid; grid-template-columns: minmax(0, 3fr) minmax(280px, 2fr); gap: 16px; align-items: start; }
.ib-editor__main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
.ib-editor__preview { position: sticky; top: 16px; min-height: 320px; }
.ib-editor__title { display: flex; align-items: center; gap: 12px; }
.ib-editor__actions { display: flex; gap: 8px; flex-wrap: wrap; }
.ib-editor__line-tools { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 12px; }
.ib-editor__catalogue { flex: 1 1 260px; }
.ib-editor__totals { display: grid; grid-template-columns: 1fr auto; gap: 6px 16px; margin: 16px 0 8px auto; max-width: 320px; }
.ib-editor__totals dd { margin: 0; text-align: right; }
.ib-editor__grand { font-weight: 800; border-top: 1px solid var(--ib-border); padding-top: 6px; }
@media (max-width: 1100px) { .ib-editor { grid-template-columns: 1fr; } .ib-editor__preview { position: static; } }
.ib-field-error { font-size: 13px; color: var(--ib-danger); font-weight: 600; }
.ib-card--dashed { border-style: dashed; }
.ib-later { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.ib-badge { display: inline-flex; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 700; background: var(--ib-st-draft-bg); color: var(--ib-st-draft-fg); }
.ib-clients { display: grid; grid-template-columns: minmax(0, 3fr) minmax(300px, 2fr); gap: 16px; align-items: start; }
.ib-clients__tools { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
.ib-clients__search { flex: 1 1 260px; }
.ib-clients__filter { flex: 0 1 200px; }
.ib-clients__paging { display: flex; justify-content: flex-end; align-items: center; gap: 8px; margin-top: 12px; }
.ib-client-row--selected { background: var(--ib-primary-soft); box-shadow: inset 3px 0 0 var(--ib-primary); }
.ib-client-row__button { display: flex; align-items: center; gap: 12px; min-height: 44px; width: 100%; padding: 4px 0; background: none; border: 0; text-align: left; font: inherit; color: var(--ib-text); cursor: pointer; }
.ib-client-row__button:focus-visible { outline: 3px solid var(--ib-focus); outline-offset: 2px; }
.ib-client-row__name { display: block; font-weight: 700; }
.ib-client-row__email { display: block; }
.ib-avatar { flex: 0 0 36px; width: 36px; height: 36px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--ib-primary-soft); color: var(--ib-primary-soft-text); font-size: 13px; font-weight: 800; }
.ib-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin: 16px 0; }
.ib-tile { display: flex; flex-direction: column; gap: 4px; padding: 12px; border: 1px solid var(--ib-border); border-radius: 12px; }
.ib-tile strong { font-size: 18px; color: var(--ib-text); }
.ib-contacts { margin: 0; padding-left: 18px; color: var(--ib-text); }
.ib-timeline { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px; color: var(--ib-text); }
.ib-timeline li { display: flex; flex-direction: column; }
@media (max-width: 959.98px) { .ib-clients { grid-template-columns: 1fr; } }
.ib-side-panel__scrim { position: fixed; inset: 0; z-index: 1300; background: rgba(0, 0, 0, 0.5); }
.ib-side-panel { position: fixed; top: 0; right: 0; bottom: 0; z-index: 1301; width: min(480px, 100vw); display: flex; flex-direction: column; background: var(--ib-surface); color: var(--ib-text); border-left: 1px solid var(--ib-border); box-shadow: -8px 0 24px rgba(0, 0, 0, 0.18); animation: ib-side-panel-in 240ms ease-out; }
.ib-side-panel__header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--ib-border); }
.ib-side-panel__body { flex: 1 1 auto; overflow-y: auto; padding: 20px; }
.ib-side-panel__footer { display: flex; justify-content: flex-end; gap: 12px; padding: 16px 20px; border-top: 1px solid var(--ib-border); }
.ib-nav-spacer { flex: 0 0 72px; }
.ib-nav--overlay { position: fixed; top: 0; bottom: 0; left: 0; z-index: 1200; width: 240px; flex: none; overflow-y: auto; box-shadow: 8px 0 24px rgba(0, 0, 0, 0.3); animation: ib-nav-in 200ms ease-out; }
@keyframes ib-nav-in { from { transform: translateX(-24px); opacity: 0; } to { transform: none; opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .ib-nav--overlay { animation: none; } }
.ib-form-stack {
@keyframes ib-side-panel-in { from { transform: translateX(100%); } to { transform: translateX(0); } }
@media (prefers-reduced-motion: reduce) { .ib-side-panel { animation: none; } }

/* dashboard (DS §8.1) */
.ib-num { text-align: right; }
.ib-text-danger { color: var(--ib-danger); font-weight: 600; }
.ib-scroll-x { overflow-x: auto; }
.ib-dash-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
.ib-dash-header .ib-page-title { margin: 0; }
.ib-dash-header__sub { margin: 4px 0 0; color: var(--ib-muted); }
.ib-dash-header__tools { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.ib-dash-search { width: 280px; max-width: 100%; }
.ib-segmented { display: inline-flex; padding: 3px; gap: 2px; border: 1px solid var(--ib-border-strong); border-radius: var(--ib-radius-control); background: var(--ib-surface); }
.ib-segmented__option { min-width: 56px; min-height: 38px; padding: 0 12px; border: 0; border-radius: 8px; background: transparent; color: var(--ib-text-2); font: inherit; font-weight: 700; cursor: pointer; }
.ib-segmented__option[aria-pressed="true"] { background: var(--ib-primary); color: var(--ib-on-primary); }
.ib-segmented__option:hover:not([aria-pressed="true"]) { background: var(--ib-primary-soft); color: var(--ib-primary-soft-text); }
.ib-segmented__option:focus-visible { outline: var(--ib-focus); outline-offset: 2px; }
.ib-dash-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
.ib-stat { display: flex; flex-direction: column; gap: 4px; padding: 20px; background: var(--ib-surface); border: 1px solid var(--ib-border); border-radius: var(--ib-radius-card); min-width: 0; }
.ib-stat__label { margin: 0; font-size: 13px; font-weight: 600; color: var(--ib-text-2); }
.ib-stat__label--danger { color: var(--ib-danger); }
.ib-stat__caption { margin: 0; font-size: 12px; font-weight: 500; color: var(--ib-muted); }
.ib-delta--up { color: var(--ib-success); font-weight: 700; }
.ib-delta--down { color: var(--ib-danger); font-weight: 700; }
.ib-dash-columns { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; align-items: flex-start; }
.ib-dash-columns__main { flex: 999 1 560px; min-width: 0; }
.ib-dash-columns__side { flex: 1 1 320px; min-width: 0; max-width: 100%; }
.ib-dash-card { padding: 20px; }
.ib-dash-card__footer { margin: 12px 0 0; text-align: right; }
.ib-dash-card a, .ib-dash-table a { color: var(--ib-primary); font-weight: 600; }
.ib-dash-table td { height: 48px; font-size: 14px; color: var(--ib-text); }
.ib-dash-table th { text-transform: uppercase; letter-spacing: .04em; }
.ib-attention { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.ib-attention__item { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 10px 12px; border-radius: 10px; background: var(--ib-surface-2); color: var(--ib-text); border-left: 3px solid var(--ib-primary); }
.ib-attention__item--danger { border-left-color: var(--ib-danger); }
.ib-attention__text { flex: 1 1 200px; font-size: 14px; }
.ib-attention__actions { display: flex; flex-wrap: wrap; gap: 4px; }
.ib-chart { display: flex; align-items: stretch; gap: 12px; height: 200px; padding-top: 8px; }
.ib-chart__col { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 6px; min-width: 0; }
.ib-chart__value { font-size: 11px; color: var(--ib-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
.ib-chart__bar { display: block; width: min(48px, 100%); border-radius: 6px 6px 0 0; background: var(--ib-chart); }
.ib-chart__bar--current { background: var(--ib-chart-current); }
.ib-chart__label { font-size: 12px; font-weight: 600; color: var(--ib-muted); }
@media (max-width: 959.98px) {
  .ib-dash-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ib-dash-search { width: 100%; }
  .ib-chart__value { display: none; }
}
